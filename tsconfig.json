{
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "diagnostics": false,
        "declaration": false,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": false,
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "skipLibCheck": true,
        "sourceMap": true,
        "strict": true,
        "target": "ES2022",
        "rootDir": "./src",
        "outDir": "./dist",
        "resolveJsonModule": true,
        "types": ["node"]
    },
    "exclude": ["dist", "node_modules", "**/*.test.ts"],
    "include": ["./src/**/*.ts"],
    "files": ["src/build-react-routes.ts"]
}
