{
    "name": "build-react-routes",
    "version": "0.12.3",
    "private": false,
    "bin": "dist/build-react-routes.js",
    "repository": {
        "url": "https://github.com/tolokoban/build-react-routes"
    },
    "dependencies": {
        "chokidar": "^5.0.0"
    },
    "scripts": {
        "prebuild": "cp package.json src/",
        "build": "tsc -p tsconfig.json",
        "prepub": "npm run build",
        "pub": "npm publish --access public",
        "start": "tsc --watch -p tsconfig.json",
        "generate": "npm run build && node ./dist/build-react-routes.js ./usecases/app",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@types/node": "^26.6.2",
        "oxfmt": "^0.70.0",
        "typescript": "^7.0.2",
        "vitest": "^5.0.1"
    }
}